APP_NAME=HomeReel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
DB_CONNECTION=sqlite
# For MariaDB use DB_CONNECTION=mysql and set the following:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=homereel
# DB_USERNAME=homereel
# DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
# Use the SAME database connection as the application; finalization is atomic.
DB_QUEUE_RETRY_AFTER=300
CACHE_STORE=database
FILESYSTEM_DISK=local
# Optional absolute private directory, outside public/. Omit for storage/app/videos.
# VIDEO_STORAGE_ROOT=/absolute/private/videos
VIDEO_MAX_BYTES=8589934592
VIDEO_CHUNK_BYTES=8388608
VIDEO_CHUNK_REQUESTS_PER_MINUTE=1200
VIDEO_STORAGE_LIMIT_BYTES=429496729600
VIDEO_UPLOAD_HOURS=48
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
VIDEO_THUMBNAILS=false
VIDEO_PROCESS_TIMEOUT=60
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=HomeReel
VITE_APP_NAME=HomeReel

# Defaults until Admin > Video settings is saved. Database settings then take precedence.
# Enable only where sustained FFmpeg CPU usage and long CLI jobs are permitted.
VIDEO_OPTIMIZATION_ENABLED=false
VIDEO_OPTIMIZATION_AUTO=false
VIDEO_OPTIMIZATION_TIMEOUT=3600
