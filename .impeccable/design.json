  "narrative": {
    "northStar": "Your private family cinema",
    "overview": "Warm charcoal, softly warm text and a restrained coral accent make HomeReel personal, peaceful and cinematic. Video imagery provides the atmosphere; the surrounding interface stays quiet, legible and comfortable for family members on phones, tablets and desktops. This system records the implementation of the user\u2019s frontend design brief and supplied mood reference.\n\nThe custom Blade viewing and login surfaces share reusable navigation, video and UI components. The custom upload panel shares their tokens and controls inside a separate native Filament administration shell. Source authority is `resources/css/components/tokens.css`, followed by the controls, shell, library, login and upload stylesheets; `resources/js/app.js` is the central Alpine entrypoint.",
    "keyCharacteristics": [
      "Warm dark surfaces and restrained coral actions.",
      "Image-led browsing with clear, compact metadata.",
      "Responsive composition, visible focus and honest media states.",
      "Separate native administration shell with a scoped upload surface."
    ],
    "rules": [
      {
        "name": "The Focus Rule",
        "body": "Custom interactive controls retain a two-pixel coral keyboard outline with a five-pixel offset; the file chooser also exposes focus within its container.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Extend the custom interface with the locally hosted Manrope family; preserve Filament\u2019s native typography in its surrounding administration shell.",
        "section": "typography"
      },
      {
        "name": "The Real Navigation Rule",
        "body": "Compose navigation from working routes and authorized actions only; keep administrator controls out of viewer surfaces.",
        "section": "layout"
      },
      {
        "name": "The Quiet Motion Rule",
        "body": "Use the shared easing `cubic-bezier(.16, 1, .3, 1)` with 160ms control and play-hint transitions and 180ms thumbnail transitions. Thumbnails scale to 1.025 and dim to 0.9 brightness on hover or keyboard focus. Disable animations and transitions for reduced motion; loading pulse is feedback rather than decoration.",
        "section": "elevation"
      },
      {
        "name": "The Frame Rule",
        "body": "Preserve 16:9 thumbnail and player geometry, with images covering thumbnails and video contained in its stage. Covers, buttons and inputs share the control radius; larger feature frames and upload panels use the feature radius. Phone feature and upload corners reduce to 14px, and player corners to 10px. The player\u2019s desktop radius is 16px and its height caps at 76svh.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** reuse the Blade navigation, video and UI components and shared CSS tokens.",
      "**Do** preserve visible keyboard focus, reduced motion, readable status text and native playback controls.",
      "**Do** use authorized real media and honest loading, missing, processing and failure states.",
      "**Do** keep upload styling scoped and extend the surrounding administration shell with native Filament components."
    ],
    "donts": [
      "**Don't** invent family imagery, public-sharing controls, albums, people, filters or search without working support.",
      "**Don't** expose private originals or thumbnails through static public URLs.",
      "**Don't** replace quiet charcoal and coral with the obsolete mint palette or the old Inter typography.",
      "**Don't** add global app CSS or Tailwind preflight to the native Filament shell."
    ]
  }
}
