  "narrative": {
    "northStar": "A quiet private screening room",
    "overview": "Dark slate surfaces, generous video imagery and mint controls keep the family collection central. The implementation is deliberately modest: a restrained wordmark, small metadata and direct, familiar controls.\n\nThe source of these tokens is `resources/css/components/library.css`, used by the Blade viewing interface and the custom upload panel. The administration shell retains Filament's existing components and configured Teal primary palette; extend that shell with its native conventions rather than restyling it to imitate the viewing interface.",
    "keyCharacteristics": [
      "Dark surfaces with clear, quiet separation.",
      "Image-led browsing and compact metadata.",
      "Visible keyboard focus and honest operational feedback."
    ],
    "rules": [
      {
        "name": "The Focus Rule",
        "body": "Interactive controls in the custom interface retain a visible mint outline with an offset.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** reuse the custom controls and spacing roles on new viewing surfaces.",
      "**Do** use Filament components and its configured Teal palette for administration shell extensions.",
      "**Do** preserve visible focus, reduced motion, live feedback and native playback controls."
    ],
    "donts": [
      "**Don't** invent family imagery or replace the honest empty state with decorative footage.",
      "**Don't** add decorative effects or elaborate branding that exceeds the modest polish brief."
    ]
  }
