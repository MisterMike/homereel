      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Shared login and upload field.",
      "html": "<label class=\"ds-label\" for=\"ds-title\">Video title</label><input id=\"ds-title\" class=\"ds-input\" placeholder=\"Video title\">",
      "css": ".ds-label{font-family:'HomeReel Inter',sans-serif;display:block;color:#edf2f3;font-size:14px;margin-bottom:9px;} .ds-input{font-family:'HomeReel Inter',sans-serif;width:100%;padding:12px 14px;border:1px solid #59646e;border-radius:6px;background:#191e23;color:#edf2f3;caret-color:#a5dfcd;} .ds-input:focus-visible{outline:2px solid #a5dfcd;outline-offset:4px;} .ds-input:disabled{opacity:.65;}"
    },
