      "kind": "card",
      "refersTo": "cover",
      "description": "Linked cover, title and date; status placeholder represents an absent thumbnail.",
      "html": "<a class=\"ds-card\" href=\"#video\"><div class=\"ds-cover\">Ready to watch<span class=\"ds-duration\">02:18</span></div><h2>Video title</h2><p>22 Nov 2026</p></a>",
      "css": ".ds-card{font-family:'HomeReel Inter',sans-serif;display:block;color:#edf2f3;text-decoration:none;min-width:0;} .ds-cover{position:relative;aspect-ratio:16/9;background:#20282f;border-radius:9px;display:grid;place-items:center;color:#b5c1c9;font-size:14px;overflow:hidden;} .ds-duration{position:absolute;right:10px;bottom:10px;padding:3px 7px;border-radius:4px;background:#101418eb;color:#edf2f3;font-size:12px;font-variant-numeric:tabular-nums;} .ds-card h2{font-size:17px;font-weight:550;margin:13px 0 5px;overflow-wrap:anywhere;} .ds-card p{font-size:13px;color:#acb6bf;} .ds-card:hover img{transform:scale(1.025);} .ds-card:focus-visible{outline:2px solid #a5dfcd;outline-offset:4px;}"
