      "description": "Primary action.",
      "html": "<button class=\"ds-button-primary\">Upload video</button>",
      "css": ".ds-button-primary{font-family:'HomeReel Inter',sans-serif;padding:12px 20px;border:1px solid transparent;border-radius:7px;background:#a5dfcd;color:#10261f;font-weight:600;line-height:1.4;cursor:pointer;transition:background .18s;} .ds-button-primary:hover{background:#bfeedd;} .ds-button-primary:focus-visible{outline:2px solid #a5dfcd;outline-offset:4px;} .ds-button-primary:disabled{opacity:.45;cursor:default;} @media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined upload pause action; shared hover background retained.",
      "html": "<button class=\"ds-button-secondary\">Pause</button>",
      "css": ".ds-button-secondary{font-family:'HomeReel Inter',sans-serif;padding:12px 20px;border:1px solid #76858e;border-radius:7px;background:transparent;color:#edf2f3;font-weight:600;line-height:1.4;cursor:pointer;transition:background .18s;} .ds-button-secondary:hover{background:#bfeedd;} .ds-button-secondary:focus-visible{outline:2px solid #a5dfcd;outline-offset:4px;} .ds-button-secondary:disabled{opacity:.45;cursor:default;} @media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none;}}"
    },
